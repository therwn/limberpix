*_check.png
*_check.gif
*_check.json
.limberpix-preview-*/
.limberpix-drawing-*/
*_parts_manifest.json
*_map_manifest.json
*_shrink_manifest.json
*_parts.png
*_parts.json
*_patches.png
*_labels.png
*_map.png
*_map.json
*_grid.png
out/

# The README's pictures are tool outputs too, kept on purpose
!docs/img/*
